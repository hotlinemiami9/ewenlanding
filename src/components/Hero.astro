---
export interface Props {
  companyName?: string;
  tagline?: string;
}
const { companyName = 'Impulso Total', tagline = 'Hacemos crecer tu marca con estrategias que funcionan' } = Astro.props;
---

<section class="hero" id="inicio">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <span class="hero-badge">&#9670; Agencia de Marketing Digital</span>
        <h1 class="hero-title">
          <span class="hero-title-line">{companyName}</span>
          <span class="hero-title-highlight">{tagline}</span>
        </h1>
        <p class="hero-text">
          Transformamos tu presencia digital con estrategias de redes sociales, SEO,
          email marketing y diseño web que generan resultados reales.
        </p>
        <div class="hero-actions">
          <a href="#servicios" class="btn btn-primary">
            Ver servicios
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#contacto" class="btn btn-outline">Solicitar presupuesto</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">+150</span>
            <span class="stat-label">Clientes satisfechos</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">+300%</span>
            <span class="stat-label">ROI promedio</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">+5M</span>
            <span class="stat-label">Alcance generado</span>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-graphic">
          <div class="graphic-circle graphic-circle--large"></div>
          <div class="graphic-circle graphic-circle--medium"></div>
          <div class="graphic-circle graphic-circle--small"></div>
          <div class="graphic-card graphic-card--top">
            <span class="graphic-card-icon">&#128200;</span>
            <span>+245% tráfico</span>
          </div>
          <div class="graphic-card graphic-card--bottom">
            <span class="graphic-card-icon">&#9889;</span>
            <span>SEO en 30 días</span>
          </div>
          <div class="graphic-card graphic-card--corner">
            <span class="graphic-card-icon">&#128640;</span>
            <span>Crecimiento real</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-wave">
    <svg viewBox="0 0 1440 160" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 80C240 160 480 0 720 80C960 160 1200 0 1440 80V160H0V80Z" fill="var(--color-bg)"/>
    </svg>
  </div>

</section>

<style>
  .hero {
    position: relative;
    padding: 7rem 0 8rem;
    background: linear-gradient(160deg, var(--color-bg-alt) 0%, #f5f3ff 50%, #fdf2f8 100%);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(108, 92, 231, 0.1);
    color: var(--color-primary);
    border-radius: var(--radius-lg);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    margin-bottom: 1.5rem;
  }

  .hero-title-line {
    display: block;
    color: var(--color-text);
  }

  .hero-title-highlight {
    display: block;
    background: var(--color-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-text {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 480px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border);
  }

  .hero-visual {
    position: relative;
    z-index: 1;
  }

  .hero-graphic {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 500px;
    margin: 0 auto;
  }

  .graphic-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.15;
  }

  .graphic-circle--large {
    width: 100%;
    height: 100%;
    background: var(--color-gradient);
    top: 0;
    left: 0;
    animation: float 6s ease-in-out infinite;
  }

  .graphic-circle--medium {
    width: 70%;
    height: 70%;
    background: var(--color-gradient-accent);
    top: 15%;
    left: 15%;
    animation: float 8s ease-in-out infinite reverse;
  }

  .graphic-circle--small {
    width: 40%;
    height: 40%;
    background: var(--color-gradient);
    top: 30%;
    left: 30%;
    animation: float 5s ease-in-out infinite;
  }

  .graphic-card {
    position: absolute;
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .graphic-card--top {
    top: 5%;
    right: 0;
    animation: float 4s ease-in-out infinite;
  }

  .graphic-card--bottom {
    bottom: 10%;
    left: 0;
    animation: float 5s ease-in-out infinite reverse;
  }

  .graphic-card--corner {
    bottom: 25%;
    right: 5%;
    animation: float 6s ease-in-out infinite;
    animation-delay: 1s;
  }

  .graphic-card-icon {
    font-size: 1.25rem;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 5rem 0 5rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero-visual {
      order: -1;
    }

    .hero-graphic {
      max-width: 300px;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-stats {
      gap: 1rem;
      justify-content: center;
    }

    .hero-text {
      font-size: 1rem;
    }
  }
  .hero-wave {
    position: absolute;
    bottom: -40px;
    left: 0;
    width: 100%;
    line-height: 0;
  }

</style>
